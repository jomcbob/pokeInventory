<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    <%= title %>
  </title>
  <link rel="stylesheet" href="/styles/adminPassword.css">
</head>

<body>
  <div class="animationOverlay">
    <div class="animationBoxOne"></div>
    <div class="animationBoxTwo"></div>
  </div>

  <form action="/teams/delete-team/admin-password" method="post">
    <label for="adminPassword">
      <h3>
        Enter Admin Password to
        <%= toBeDeleted==='team' ? 'Dissolve' : 'Free' %>
          <%= toBeDeleted %>
            <%= toBeDeleted==='team' ? trainerName : pokemonName %>
      </h3>
    </label>
    <input autofocus type="password" id="adminPassword" name="adminPassword" required>
    <input type="hidden" name="trainerName" value="<%= trainerName %>">
    <input type="hidden" name="pokemonName" value="<%= pokemonName %>">
    <input type="hidden" name="toBeDeleted" value="<%= toBeDeleted %>">
    <div class="buttons">
      <button class="button-link delete" type="submit">Submit</button>
      <a class="button-link" href="/teams/delete-team?trainerName=<%= trainerName %>">Go Back</a>
    </div>
  </form>

</body>

</html>