<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    <%= title %>
  </title>
  <link rel="stylesheet" href="/styles/newTeam.css">
</head>

<body>
  <form method="POST" action="/teams/new-team">
    <label for="trainerName"><h3>Trainer Name</h3></label>
    <input autofocus placeholder="i.e Bob" type="text" id="trainerName" name="trainerName" />
    <div class="buttons">
      <button class="submit button-link" type="submit">Add Team</button>
      <a href="/teams/" class="button-link">Go Back</a>
    </div>
  </form>

</body>

</html>