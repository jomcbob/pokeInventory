<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    <%= title %>
  </title>
  <link rel="stylesheet" href="/styles/index.css">
  <link rel="stylesheet" href="https://unpkg.com/tippy.js@6/dist/tippy.css" />
  <script src="https://unpkg.com/@popperjs/core@2"></script>
  <script src="https://unpkg.com/tippy.js@6"></script>
</head>

<body>

  <%- include('partials/header', { links: [ { text: 'Home' , href: '/' }, { text: 'New Team' , href: '/teams/new-team'
    }, ] }) %>

    <div class="pagination">
      <button class="sliderButtons" id="prevBtn" disabled>Previous</button>
      <button class="sliderButtons" id="nextBtn">Next</button>
    </div>

    <div class="allTeams" id="allTeams"></div>

    <script>
      const teamsData = <%- JSON.stringify(teams) %>;
      const ballSize = "<%= ballSize %>";

      const allTeamsDiv = document.getElementById('allTeams');
      const prevBtn = document.getElementById('prevBtn');
      const nextBtn = document.getElementById('nextBtn');

      let currentPage = 0;
      const teamsPerPage = 10;
      const teams = teamsData;

      function renderTeams() {
        allTeamsDiv.innerHTML = '';
        const start = currentPage * teamsPerPage;
        const end = start + teamsPerPage;
        const pageTeams = teams.slice(start, end);

        pageTeams.forEach(t => {
          const teamDiv = document.createElement('div');
          teamDiv.className = 'clip';
          teamDiv.innerHTML = `
            <div class="teambody">
              <div class="flexRow">
                <h3>${t.trainer}</h3>
                <div class="flexRow">
                  <form method="GET" action="/teams/catch-pokemon" onsubmit="return checkIfTooManyPokemon(${t.team.length})">
                    <input type="hidden" name="trainerName" value="${t.trainer}" />
                    <button type="submit" class="addPokemon button-link">+ Pokémon</button>
                  </form>
                  <form method="GET" action="/teams/delete-team">
                    <input type="hidden" name="trainerName" value="${t.trainer}" />
                    <button type="submit" class="addPokemon button-link">- Pokémon</button>
                  </form>
                </div>
              </div>
              <div class="pokemons">
                ${t.team.map(pokemon => `
                  <div class="pokemon">
                    <div class="pokemon-ball" data-info="${pokemon.name}" 
                        style="position: relative; height: ${ballSize}; width: ${ballSize};">
                      <img src="${pokemon.sprite}" alt="${pokemon.name}" 
                          style="position:absolute; top:0; left:0; width:${ballSize}; height:${ballSize}; object-fit:contain;" />
                      <svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg" 
                          style="position: absolute; top:0; left:0; width:${ballSize}; height:${ballSize};">
                        <circle cx="100" cy="100" r="95" fill="none" stroke="black" stroke-width="5" />
                        <path d="M5,100 a95,95 0 0,1 190,0" fill="red" fill-opacity="0.4" stroke="black" stroke-width="3" />
                        <path d="M5,100 a95,95 0 0,0 190,0" fill="white" fill-opacity="0.2" stroke="black" stroke-width="3" />
                        <circle cx="100" cy="100" r="25" fill="white" fill-opacity="0.4" stroke="black" stroke-width="5" />
                      </svg>
                    </div>
                  </div>
                `).join('')}
        </div>
      </div>
    `;
          allTeamsDiv.appendChild(teamDiv);
        });

        prevBtn.disabled = currentPage === 0;
        nextBtn.disabled = end >= teams.length;


      document.querySelectorAll('.pokemon-ball').forEach(el => {
        tippy(el, {
          content: el.dataset.info,
          placement: 'top',
          animation: 'fade',
          theme: 'light',
        });
      });
      }

      prevBtn.addEventListener('click', () => {
        if (currentPage > 0) {
          currentPage--;
          allTeamsDiv.classList.add('left-page');

          renderTeams()

          setTimeout(() => {
            allTeamsDiv.classList.remove('left-page');
          }, 600)
        }
      });

      nextBtn.addEventListener('click', () => {
        if ((currentPage + 1) * teamsPerPage < teams.length) {
          currentPage++;
          allTeamsDiv.classList.add('right-page');

          renderTeams();

          setTimeout(() => {
            allTeamsDiv.classList.remove('right-page');
          }, 600)
        }
      });

      function checkIfTooManyPokemon(length) {
        if (length >= 6) {
          alert("You already have 6 Pokémon on this team!");
          return false;
        }
        return true;
      }

      renderTeams();

    </script>
</body>

</html>