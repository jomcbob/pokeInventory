<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    <%= title %>
  </title>
  <script>
    const pokemons = <%- JSON.stringify(pokemons) %>;
  </script>
  <script src="/js/search.js"></script>
  <link rel="stylesheet" href="/styles/pokemon.css">
</head>

<body>
  <form method="POST" action="/teams/catch-pokemon">
    <input type="hidden" name="trainerName" value="<%= trainerName %>" />
    <h2>    <%= trainerName %></h2>
    <label for="caughtPokemon"><h3>Search Pokemon</h3></label>
    <input type="text" name="caughtPokemon" id="caughtPokemon">
    <div class="buttons">
      <button class="submit" type="submit">submit</button>
      <a href="/teams/"><button type="button">go back</button></a>
    </div>
  </form>
  <div class="searchMatchesContainer">
    <div id="searchMatches"></div>
  </div>
</body>

</html>