<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    <%= title %>
  </title>
  <link rel="stylesheet" href="/styles/index.css">
</head>

<body>
  <%- include('partials/header', { links: [ { text: 'Teams' , href: '/teams' }, ] }) %>

    <div class="sections">
      <div class="PokeInventoryText">
        <h2>Welcome to PokéInventory!</h2>
        <p>Your one-stop app for managing your Pokémon teams and inventory.</p>
        <ul>
          <li><strong>Create and manage multiple teams:</strong> Easily create new teams, add or remove Pokémon, and
            keep track of your favorite lineups.</li>
          <li><strong>Pokémon inventory management:</strong> Store and organize all your caught Pokémon in one place,
            making it easy to find and manage them.</li>
          <li><strong>User-friendly interface:</strong> Navigate through the app with ease using our intuitive design
            and layout.</li>
          <li><strong>Note:</strong> anybody that’s visiting the site can Create, Update and Read any Team or Pokemon but you
            must be an Admin to Delete any Team or Pokemon.</li>
        </ul>
        <p>Get started by creating a new team or exploring the existing teams!</p>
      </div>

      <h2 class="onlyTheStats">Only the Stats</h2>


      <div class="stats">
        <div class="stat">Total Teams: <strong id="total-teams">0</strong></div>
        <div class="stat">Total Pokémon on All Teams: <strong id="total-pokemon">0</strong></div>
      </div>

<script>
  function animateCounter(elementId, targetNumber, duration) {
    const element = document.getElementById(elementId);
    let start = 0;
    const stepTime = Math.abs(Math.floor(duration / targetNumber));

    const timer = setInterval(() => {
      start += 1;
      element.textContent = start;
      if (start >= targetNumber) {
        clearInterval(timer);
      }
    }, stepTime);
  }

  const totalTeams = <%= numberOfTeams %>
  const totalPokemon = <%= numberOfPokemonOnAllTeams %>

  animateCounter("total-teams", totalTeams, 1000);
  animateCounter("total-pokemon", totalPokemon, 1000);
</script>

</body>

</html>