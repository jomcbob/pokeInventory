<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    <%= title %>
  </title>
  <link rel="stylesheet" href="/styles/delete.css">
</head>

<body>
  <div class="container">
    <h3>
      <%= trainerName %>
    </h3>

    <div class="buttons">
      <form method="POST" action="/teams/delete-team" style="display:inline;">
        <input type="hidden" name="trainerName" value="<%= trainerName %>">
        <input type="hidden" name="toBeDeleted" value="team">
        <button class="submit button-link delete" type="submit">Dissolve Team</button>
      </form>
      <a href="/teams/" class="button-link">Go Back</a>
    </div>

    <div class="pokemonBox">
      <% teamMembers.forEach(teamMember=> { %>
        <form tabindex="0" class="pokemonToBeDeleted" method="POST" action="/teams/delete-team">
          <div>Free <%= teamMember.name %>
          </div>
          <img src="<%= teamMember.sprite %>" alt="">
          <input type="hidden" name="trainerName" value="<%= trainerName %>">
          <input type="hidden" name="pokemonName" value="<%= teamMember.name %>">
          <input type="hidden" name="toBeDeleted" value="pokemon">
        </form>
        <% }) %>
    </div>
  </div>

  <script>
    document.querySelectorAll('.pokemonToBeDeleted').forEach(form => {
      form.addEventListener('click', () => form.submit());

      form.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault()
          form.submit()
        }
      });
    });

  </script>

</body>

</html>